# Copy to deploy/.env, fill in, then: chmod 600 .env
# Never commit the real .env. Keep a copy of the values in a password manager.

# Keeps container and volume names stable (porchlight-db-1, porchlight_db-data, ...).
COMPOSE_PROJECT_NAME=porchlight

# Tag for the built image. Bump it per deploy (e.g. the git commit) so you can roll back.
APP_TAG=latest

# Generate with: openssl rand -base64 32 | tr -d '/+='
# Only used when the database is first created; changing it later needs ALTER USER too.
POSTGRES_PASSWORD=

# The public HTTPS address, no trailing slash.
PUBLIC_ORIGIN=https://porchlight.example.com

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application).
# Authorized JavaScript origin: the PUBLIC_ORIGIN above.
GOOGLE_CLIENT_ID=

# Can sign up without an invite (the owner, to create the first circle).
BOOTSTRAP_EMAIL=

# Web Push. Generate once and never change after people subscribe:
#   docker build -f deploy/Dockerfile -t porch-light .   (from the repo root)
#   docker run --rm porch-light generate-vapid
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Minutes before a scheduled favor to send the reminder.
REMINDER_LEAD_MINUTES=120

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
# Public hostname route: porchlight.<domain>  ->  http://app:8080
TUNNEL_TOKEN=
